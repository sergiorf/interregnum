; Engine configuration file.
; Edit with the Godot editor where possible.

config_version=5

[application]

config/name="Interregnum"
run/main_scene="res://Scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#")
config/icon="res://Assets/interregnum.png"
boot_splash/image="res://Assets/interregnum.png"
boot_splash/bg_color=Color(0.035, 0.047, 0.055, 1)
boot_splash/fullsize=false

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="Interregnum.Game"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.055, 1)
